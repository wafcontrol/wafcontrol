SECRET_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxx
DEBUG=False
ALLOWED_HOSTS=127.0.0.1,localhost

DB_ENGINE=django.db.backends.postgresql
DB_NAME=db
DB_USER=user
DB_PASS=pass
DB_HOST=127.0.0.1
DB_PORT=5432

CSRF_COOKIE_SECURE=True
SESSION_COOKIE_SECURE=True
SECURE_BROWSER_XSS_FILTER=True
SECURE_CONTENT_TYPE_NOSNIFF=True
X_FRAME_OPTIONS=DENY
CSRF_TRUSTED_ORIGINS=https://yourdomain.com
SECURE_PROXY_SSL_HEADER=HTTP_X_FORWARDED_PROTO,https
USE_X_FORWARDED_HOST=True
# Optional: GitHub token used to fetch CRS releases (raises the 60 requests/hour anonymous limit)
GITHUB_TOKEN=

# Optional: outbound proxy for GitHub / CRS downloads (restart the panel and Celery after changing).
# Lowercase variants are needed by some tools (wget/curl).
#HTTP_PROXY=http://proxy.example:8080
#HTTPS_PROXY=http://proxy.example:8080
#http_proxy=http://proxy.example:8080
#https_proxy=http://proxy.example:8080
#NO_PROXY=localhost,127.0.0.1
#no_proxy=localhost,127.0.0.1

# Optional: Redis used by Celery (default redis://localhost:6379/0)
#CELERY_BROKER_URL=redis://localhost:6379/0
